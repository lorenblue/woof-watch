datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

model Actor {
  id         String    @id @default(cuid())
  name       String    @unique
  code       String?   @unique
  codeUsedAt DateTime?
  createdAt  DateTime  @default(now())

  eventsRecorded DogEvent[] @relation("RecordedBy")
  eventsUndone   DogEvent[] @relation("UndoneBy")
  pushes         PushSubscription[]
  sessions       Session[]

  @@map("actor")
}

model Dog {
  id   String @id @default(cuid())
  name String @unique

  events DogEvent[]
  @@map("dog")
}

model ActionType {
  key String @id

  events DogEvent[]
  @@map("action_type")
}

model DogEvent {
  id           String   @id @default(cuid())
  dogId        String
  actionTypeId String
  occurredAt   DateTime @default(now())
  actorId      String

  undoneAt   DateTime?
  undoneById String?

  dog        Dog        @relation(fields: [dogId], references: [id], onDelete: Cascade)
  actionType ActionType @relation(fields: [actionTypeId], references: [key], onDelete: Restrict)

  actor    Actor  @relation("RecordedBy", fields: [actorId], references: [id], onDelete: Restrict)
  undoneBy Actor? @relation("UndoneBy", fields: [undoneById], references: [id], onDelete: SetNull)

  @@index([dogId, actionTypeId, undoneAt, occurredAt(sort: Desc)])
  @@index([actorId])
  @@index([occurredAt])

  @@map("dog_event")
}

model Session {
  id      String @id @default(cuid())
  actorId String
  actor   Actor  @relation(fields: [actorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  expiresAt DateTime

  userAgent String?
  ipAddress String?

  @@index([actorId])

  @@map("session")
}

model PushSubscription {
  id         String   @id @default(cuid())
  actorId    String
  endpoint   String   @unique
  p256dh     String
  auth       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])

  @@map("push_subscription")
}