datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

model Actor {
  id         String    @id @default(cuid())
  name       String    @unique
  code       String    @unique
  codeUsedAt DateTime?
  createdAt  DateTime  @default(now())

  events   DogEvent[]
  pushes   PushSubscription[]
  sessions Session[]
}

model Dog {
  id   String @id
  name String @unique

  events DogEvent[]
}

model ActionType {
  id  String @id @default(cuid())
  key String @unique

  events DogEvent[]
}

model DogEvent {
  id           String   @id @default(cuid())
  dogId        String
  actionTypeId String
  occurredAt   DateTime @default(now())
  recordedAt   DateTime @default(now())
  actorId      String

  undoneAt   DateTime?
  undoneById String?

  dog        Dog        @relation(fields: [dogId], references: [id])
  actionType ActionType @relation(fields: [actionTypeId], references: [id])
  actor      Actor      @relation(fields: [actorId], references: [id])

  @@index([dogId, actionTypeId, undoneAt, occurredAt(sort: Desc)])
}

model Session {
  id      String @id @default(cuid())
  actorId String
  actor   Actor  @relation(fields: [actorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  expiresAt DateTime

  userAgent String?
  ipAddress String?

  @@index([actorId])
}

model PushSubscription {
  id         String   @id @default(cuid())
  actorId    String
  endpoint   String   @unique
  p256dh     String
  auth       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  actor Actor @relation(fields: [actorId], references: [id])

  @@index([actorId])
}